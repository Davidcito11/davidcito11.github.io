---
import Container from "../shared/Container.astro";
---

<section class="relative mt-12 md:mt-16">
  <Container>
    <div
      class="mx-auto p-5 sm:p-6 py-6 sm:py-8 max-w-5xl rounded-3xl bg-box-bg border border-box-border shadow-lg shadow-box-shadow grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 md:gap-6 lg:gap-12 place-items-center"
    >
      <div class="text-center">
        <h2
          class="font-semibold text-xl sm:text-2xl md:text-4xl text-heading-1"
        >
          Junior
        </h2>
        <p class="mt-2 text-heading-3">Developer</p>
      </div>

      <div class="text-center md:border-l md:border-box-border md:pl-4 lg:pl-8">
        <h2
          class="font-semibold text-xl sm:text-2xl md:text-4xl text-heading-1"
        >
          2
        </h2>
        <p class="mt-2 text-heading-3">Worked on projects</p>
      </div>

      <div class="text-center md:border-l md:border-box-border md:pl-4 lg:pl-8">
        <h2
          class="font-semibold text-xl sm:text-2xl md:text-4xl text-heading-1"
        >
          2+
        </h2>
        <p class="mt-2 text-heading-3">Years of experience</p>
      </div>

      <div class="text-center md:border-l md:border-box-border md:pl-4 lg:pl-8">
        <h2
          class="font-semibold text-xl sm:text-2xl md:text-4xl text-heading-1"
        >
          24
        </h2>
        <p class="mt-2 text-heading-3">Age</p>
      </div>
    </div>
  </Container>
</section>
